{
  "expo": {
    "name": "curso-react-native-metacritic-app",
    "slug": "curso-react-native-metacritic-app",
    "scheme": "rickandmortyapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
          "./assets/fonts/BBHSansHegarty-Regular.ttf",
          "node_modules/@expo-google-fonts/dm-sans/400Regular/DMSans_400Regular.ttf"
          ]
        }

      ]
    ]
  }
}
